{
  "name": "@kafkalens/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "KafkaLens Desktop Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "build:unpack": "npm run build && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "avsc": "^5.7.9",
    "better-sqlite3": "13.0.3",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "jsonpath-plus": "^11.1.1",
    "kafkajs": "2.2.4",
    "protobufjs": "^8.8.0",
    "re2-wasm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.21",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vite": "7.3.6",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.kafkalens.app",
    "productName": "KafkaLens",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "KafkaLens-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Captain-Sangam",
      "repo": "KafkaLens"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "dmg": {
      "sign": true
    },
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      }
    ]
  },
  "author": "KafkaLens Contributors",
  "license": "MIT"
}
